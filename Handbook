    .poster-header .title-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .poster-header .kicker {
      text-transform: uppercase;
      letter-spacing: 10px;
      font-size: clamp(10px, 1vw, 14px);
      opacity: 0.8;
    }

    .poster-header h2 {
